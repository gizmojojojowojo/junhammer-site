---
import { fmtDate, TOPICS, type Post } from '../lib';
interface Props { posts: Post[]; showTopic?: boolean }
const { posts, showTopic = true } = Astro.props;
---
<ol class="posts">
  {posts.map((p) => (
    <li>
      <a href={`/blog/${p.id}/`}>
        <span class="t">{p.data.title}</span>
        <span class="m meta">
          {showTopic && <span>{TOPICS[p.data.topic].label}</span>}
          <time datetime={(p.data.updated ?? p.data.date).toISOString()}>{fmtDate(p.data.updated ?? p.data.date)}</time>
          {p.data.pillar && <span class="pill">Guide</span>}
        </span>
      </a>
    </li>
  ))}
</ol>
<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .posts li { border-bottom: 1px solid var(--rule); }
  .posts a { display: grid; grid-template-columns: 1fr auto; gap: .35rem 2rem; padding: 1.1rem 0; text-decoration: none; color: var(--ink); }
  .t { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; line-height: 1.3; letter-spacing: -0.01em; }
  .posts a:hover .t { color: var(--fjord); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .m { display: flex; gap: 1rem; white-space: nowrap; align-self: center; }
  .pill { background: var(--highlight); color: var(--highlight-ink); padding: 0 .45rem; border-radius: 3px; font-weight: 600; }
  @media (max-width: 700px) { .posts a { grid-template-columns: 1fr; } .m { white-space: normal; flex-wrap: wrap; } }
</style>
