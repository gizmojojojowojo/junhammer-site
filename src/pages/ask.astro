---
import Base from '../layouts/Base.astro';

const examples = [
  'What is the difference between AEO and GEO?',
  'What AI tools has Joe built?',
  'How long does SEO take to work?',
  'When should I use an AI agent instead of a workflow?',
];
---
<Base
  title="Ask this site"
  seoTitle="Ask Joe Unhammer's Site: AI Answers With Sources"
  description="Ask a question about AI engineering, AEO, SEO or Joe Unhammer's work. An AI model answers from the pages on this site and links every source."
>
  <div class="narrow ask">
    <header class="page-head">
      <h1>Ask this site</h1>
      <p class="lede">Ask about AI engineering, AEO, SEO or my work. An AI model writes the answer from pages on this site and links each source.</p>
    </header>

    <div id="ask-thread" class="ask-thread"></div>
    <p id="ask-status" class="ask-sr" role="status" aria-live="polite"></p>

    <form id="ask-form" class="ask-form" action="/blog/" method="get">
      <label class="ask-sr" for="ask-q">Your question</label>
      <input id="ask-q" name="q" type="text" maxlength="400" required autocomplete="off" placeholder="Ask a question" />
      <button class="btn" type="submit">Ask</button>
    </form>

    <div id="ask-examples" class="ask-examples">
      <p class="meta">Try one:</p>
      <ul>
        {examples.map((q) => <li><button type="button" data-q={q}>{q}</button></li>)}
      </ul>
    </div>

    <p class="meta ask-note">Answers are written by Claude, an AI model from Anthropic, using only content from junhammer.com. Your question is sent to Anthropic to write the answer. Check the linked source before you rely on a detail, or <a href="/contact/">ask me directly</a>.</p>
    <noscript><p class="meta">This page needs JavaScript. You can browse <a href="/blog/">the writing archive</a> or <a href="/services/">services</a> instead.</p></noscript>
  </div>
</Base>

<script>
  const form = document.getElementById('ask-form');
  const input = document.getElementById('ask-q');
  const thread = document.getElementById('ask-thread');
  const status = document.getElementById('ask-status');
  const examples = document.getElementById('ask-examples');
  const button = form.querySelector('button');
  const history = [];
  let busy = false;

  const el = (tag, cls, text) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text) node.textContent = text;
    return node;
  };

  // Renders the small set of Markdown the model is allowed to use. Text goes in
  // through textContent, and a link is created only when its URL was in the
  // retrieved sources, so the model cannot inject markup or invent a link.
  function inline(parent, text, sources, links, cited) {
    const pattern = /\*\*([^*]+)\*\*|\[([^\]]+)\]\(([^)\s]+)\)|\[(\d+)\]/g;
    let last = 0;
    for (const m of text.matchAll(pattern)) {
      parent.append(text.slice(last, m.index));
      last = m.index + m[0].length;
      if (m[1]) parent.append(el('strong', '', m[1]));
      else if (m[2]) {
        if (links.has(m[3])) {
          const a = el('a', '', m[2]);
          a.href = m[3];
          if (/^https?:/.test(m[3])) a.rel = 'noopener';
          parent.append(a);
        } else parent.append(m[2]);
      } else {
        const source = sources[Number(m[4]) - 1];
        if (source) {
          const a = el('a', 'cite', m[4]);
          a.href = source.url;
          a.title = source.title;
          a.setAttribute('aria-label', 'Source ' + m[4] + ': ' + source.title);
          parent.append(a);
          cited.add(Number(m[4]));
        } else parent.append(m[0]);
      }
    }
    parent.append(text.slice(last));
  }

  function renderAnswer(box, text, sources, links) {
    const cited = new Set();
    const nodes = [];
    let list = null;
    for (const raw of text.split('\n')) {
      const line = raw.trim();
      if (!line) {
        list = null;
        continue;
      }
      const item = line.match(/^(?:[-*]|\d+\.)\s+(.*)$/);
      if (item) {
        if (!list) {
          list = el(/^\d/.test(line) ? 'ol' : 'ul');
          nodes.push(list);
        }
        const li = el('li');
        inline(li, item[1], sources, links, cited);
        list.append(li);
      } else {
        list = null;
        const p = el('p');
        inline(p, line.replace(/^#+\s*/, ''), sources, links, cited);
        nodes.push(p);
      }
    }
    box.replaceChildren(...nodes);
    return cited;
  }

  function renderSources(box, sources, cited, heading) {
    const shown = cited && cited.size ? sources.filter((s) => cited.has(s.n)) : sources;
    if (!shown.length) return;
    box.replaceChildren(el('h3', '', heading));
    const list = el('ol');
    for (const s of shown) {
      const li = el('li');
      li.value = s.n;
      const a = el('a', '', s.title);
      a.href = s.url;
      li.append(a);
      if (s.heading) li.append(el('span', 'ask-where', s.heading));
      if (!cited) li.append(el('p', 'ask-snippet', s.snippet));
      list.append(li);
    }
    box.append(list);
  }

  async function readStream(res, onEvent) {
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const blocks = buffer.split('\n\n');
      buffer = blocks.pop();
      for (const block of blocks) {
        const event = block.match(/^event: (.+)$/m);
        const data = block.match(/^data: (.+)$/m);
        if (event && data) onEvent(event[1], JSON.parse(data[1]));
      }
    }
  }

  async function ask(question) {
    if (busy || !question.trim()) return;
    busy = true;
    button.disabled = true;
    examples.hidden = true;
    status.textContent = 'Looking through the site.';

    const turn = el('article', 'ask-turn');
    const answer = el('div', 'ask-answer prose');
    const sourceBox = el('div', 'ask-sources');
    answer.append(el('p', 'ask-wait', 'Looking through the site…'));
    turn.append(el('h2', 'ask-question', question), answer, sourceBox);
    thread.append(turn);
    turn.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const say = (text) => answer.replaceChildren(el('p', '', text));
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question, history }),
      });
      const type = res.headers.get('content-type') || '';
      if (type.includes('text/event-stream')) {
        let text = '';
        let sources = [];
        let links = new Set();
        let failed = '';
        await readStream(res, (event, data) => {
          if (event === 'sources') {
            sources = data.sources;
            links = new Set(data.links);
            status.textContent = 'Writing the answer.';
          } else if (event === 'delta') {
            text += data.text;
            renderAnswer(answer, text, sources, links);
          } else if (event === 'error') failed = data.message;
        });
        if (failed && !text) say(failed);
        else {
          const cited = renderAnswer(answer, text, sources, links);
          if (failed) answer.append(el('p', 'meta', failed));
          renderSources(sourceBox, sources, cited, cited.size ? 'Sources' : 'Related pages');
          history.push({ role: 'user', content: question }, { role: 'assistant', content: text });
          if (history.length > 4) history.splice(0, history.length - 4);
        }
      } else {
        const data = await res.json();
        if (data.error) say(data.error);
        else if (data.mode === 'no_match') {
          say('This site does not cover that. It covers AI engineering, AI agents, answer engine optimization, SEO and my work.');
          const more = el('p');
          const a = el('a', '', 'Ask me directly');
          a.href = '/contact/';
          more.append(a, '.');
          answer.append(more);
        } else {
          say(data.limited ? 'AI answers are at their limit for now. These pages match your question:' : 'These pages match your question:');
          renderSources(sourceBox, data.sources, null, 'Best matches');
        }
      }
      status.textContent = 'Answer ready.';
    } catch (err) {
      say('Something went wrong. Try again in a moment.');
      status.textContent = 'Something went wrong.';
    }
    busy = false;
    button.disabled = false;
    input.value = '';
    input.placeholder = 'Ask a follow-up';
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    ask(input.value);
  });
  examples.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => ask(b.dataset.q)));

  // Other pages can link here with a question: /ask/?q=...
  const preset = new URLSearchParams(location.search).get('q');
  if (preset) ask(preset.slice(0, 400));
</script>

<style is:global>
  .ask { padding-bottom: clamp(3rem, 8vw, 6rem); }
  .ask-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ask-form { display: flex; gap: .6rem; margin-top: 1rem; }
  .ask-form input { flex: 1; min-width: 0; font: inherit; font-family: var(--font-ui); padding: .8rem .9rem; border: 1px solid var(--rule); border-radius: var(--radius-s); background: var(--surface); color: var(--ink); }
  .ask-form button:disabled { opacity: .55; cursor: default; }
  .ask-form .btn { cursor: pointer; }
  .ask-examples { margin-top: 1.25rem; }
  .ask-examples p { margin: 0 0 .5rem; }
  .ask-examples ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .ask-examples button { font: inherit; font-family: var(--font-ui); font-size: var(--step--1); text-align: left; padding: .5rem .75rem; border: 1px solid var(--rule); border-radius: var(--radius-s); background: var(--surface); color: var(--fjord); cursor: pointer; }
  .ask-examples button:hover { border-color: var(--fjord); }
  .ask-note { margin-top: 2rem; max-width: var(--measure); }
  .ask-turn { padding-block: 1.5rem; border-top: 1px solid var(--rule); scroll-margin-top: 5rem; }
  .ask-turn:first-child { border-top: 0; padding-top: 0; }
  .ask-question { font-size: var(--step-1); margin-bottom: .9rem; }
  .ask-wait { color: var(--ink-soft); }
  .ask-sources { margin-top: 1.25rem; font-family: var(--font-ui); font-size: var(--step--1); }
  .ask-sources h3 { font-size: var(--step--1); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-soft); margin-bottom: .5rem; }
  .ask-sources ol { margin: 0; padding-left: 1.4rem; display: grid; gap: .45rem; }
  .ask-where { color: var(--ink-soft); }
  .ask-where::before { content: ' · '; }
  .ask-snippet { margin: .2rem 0 0; color: var(--ink-soft); font-family: var(--font-body); }
  @media (max-width: 520px) { .ask-form { flex-direction: column; } .ask-form .btn { justify-content: center; } }
</style>
