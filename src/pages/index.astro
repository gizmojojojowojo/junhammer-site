---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getServices, getWork } from '../lib';
import home from '../data/home.json';
import { inline } from '../inline';
const [services, work, posts] = await Promise.all([getServices(), getWork(), getPosts()]);
const build = services.filter((s) => s.id.startsWith('ai-'));
const found = services.filter((s) => !s.id.startsWith('ai-'));
const latest = posts.slice(0, 5);
---
<Base title={home.seoTitle} seoTitle={home.seoTitle} description={home.metaDescription}>
  <section class="hero">
    <img
      class="hero-img"
      src={home.heroImage.replace('-1920', '-1200')}
      srcset={`${home.heroImage.replace('-1920', '-800')} 800w, ${home.heroImage.replace('-1920', '-1200')} 1200w, ${home.heroImage} 1920w`}
      sizes="100vw"
      alt={home.heroImageAlt}
      width="1920"
      height="1440"
      fetchpriority="high"
    />
    <div class="wrap hero-inner">
      <p class="query"><span class="q-label">Asked</span> {home.query}</p>
      <h1 class="answer" set:html={inline(home.answer)} />
      <div class="actions">
        <a class="btn" href={home.primaryButton.href}>{home.primaryButton.label}</a>
        <a class="btn ghost" href={home.secondaryButton.href}>{home.secondaryButton.label}</a>
      </div>
      <ol class="sources" aria-label="Sources">
        {home.sources.map((src, i) => <li id={`src-${i + 1}`}><a href={src.href}>{src.label}</a></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{home.servicesHeading}</h2>
        <p set:html={inline(home.servicesIntro)} />
      </div>
      <div class="split">
        <div>
          <h3 class="group">{home.buildLabel}</h3>
          <ul class="svc">{build.map((s) => <li><a href={`/services/${s.id}/`}><strong>{s.data.title}</strong><span>{s.data.summary}</span></a></li>)}</ul>
        </div>
        <div>
          <h3 class="group">{home.foundLabel}</h3>
          <ul class="svc">{found.map((s) => <li><a href={`/services/${s.id}/`}><strong>{s.data.title}</strong><span>{s.data.summary}</span></a></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{home.workHeading}</h2>
        <p set:html={inline(home.workIntro)} />
      </div>
      <ol class="cases">
        {work.slice(0, 4).map((w) => (
          <li>
            <a href={`/work/${w.id}/`}>
              <span class="who meta">{w.data.client}</span>
              <strong>{w.data.title}</strong>
              {w.data.results[0] && <span class="stat"><b>{w.data.results[0].value}</b> {w.data.results[0].label}</span>}
            </a>
          </li>
        ))}
      </ol>
      <p class="more"><a href="/work/">All case studies</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="section-head">
        <h2>{home.writingHeading}</h2>
        <p set:html={inline(home.writingIntro)} />
        <p><a href="/blog/">Browse all writing</a></p>
      </div>
      <PostList posts={latest} />
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="section-head">
        <h2>{home.aboutHeading}</h2>
      </div>
      <div class="bio-wrap">
        {home.portrait && <img class="portrait" src={home.portrait} alt="Joe Unhammer" width="640" height="640" loading="lazy" />}
        <div class="prose bio">
          {home.about.map((para) => <p set:html={inline(para)} />)}
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; color: #f6eef0; min-height: min(78vh, 44rem); display: flex; align-items: flex-end; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; z-index: -2; }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgb(6 14 71 / .15) 0%, rgb(6 14 71 / .55) 45%, rgb(6 14 71 / .92) 100%),
      linear-gradient(90deg, rgb(6 14 71 / .55) 0%, rgb(6 14 71 / 0) 70%);
  }
  .hero-inner { padding-block: clamp(6rem, 18vh, 10rem) clamp(2.5rem, 6vw, 4rem); }
  .query {
    display: inline-flex; flex-wrap: wrap; gap: .3rem .6rem; align-items: baseline;
    font-family: var(--font-ui); font-size: .95rem; color: #f6eef0;
    background: rgb(255 255 255 / .12); border: 1px solid rgb(255 255 255 / .28);
    backdrop-filter: blur(6px); border-radius: 1.4rem;
    padding: .45rem 1rem; margin: 0 0 1.25rem; max-width: 100%;
  }
  .q-label { font-weight: 700; color: #f2c6d1; }
  .answer {
    font-family: var(--font-body); font-weight: 400; font-size: clamp(1.45rem, 2.6vw, 2.15rem);
    line-height: 1.4; letter-spacing: -0.01em; max-width: 38ch; color: #fbf6f7;
    text-shadow: 0 1px 12px rgb(6 14 71 / .35);
  }
  .answer :global(.mark) {
    background: none; color: inherit; padding: 0;
    text-decoration: underline; text-decoration-color: #e7a3b5; text-decoration-thickness: .12em; text-underline-offset: .22em;
  }
  .answer :global(.cite) { color: #f2c6d1; font-size: .6em; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .hero .btn { background: #f2c6d1; border-color: #f2c6d1; color: #060e47; }
  .hero .btn:hover { background: #ffffff; border-color: #ffffff; }
  .hero .btn.ghost { background: transparent; color: #fbf6f7; border-color: rgb(255 255 255 / .6); }
  .hero .btn.ghost:hover { background: rgb(255 255 255 / .12); }
  .sources {
    margin: 2.25rem 0 0; padding: .9rem 0 0 1.3rem; border-top: 1px solid rgb(255 255 255 / .25);
    display: flex; flex-wrap: wrap; gap: .4rem 2.25rem; font-family: var(--font-ui); font-size: var(--step--1);
  }
  .sources li::marker { color: #f2c6d1; font-weight: 700; }
  .sources a { color: #f6eef0; text-decoration-color: rgb(255 255 255 / .4); }
  .sources a:hover { text-decoration-color: currentColor; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .group { font-size: var(--step-1); padding-bottom: .75rem; border-bottom: 2px solid var(--ink); }
  .svc { list-style: none; margin: 0; padding: 0; }
  .svc a { display: grid; gap: .3rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .svc strong { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.01em; }
  .svc span { color: var(--ink-soft); font-size: 1rem; }
  .svc a:hover strong { color: var(--fjord); text-decoration: underline; text-underline-offset: .2em; }

  .cases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 3rem; counter-reset: c; }
  .cases li { border-top: 1px solid var(--rule); counter-increment: c; }
  .cases a { display: grid; gap: .4rem; padding: 1.5rem 0 1.75rem; text-decoration: none; color: var(--ink); }
  .cases a::before { content: '[' counter(c) ']'; font-family: var(--font-ui); font-weight: 700; color: var(--fjord); font-size: .95rem; }
  .cases strong { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.25; letter-spacing: -0.01em; }
  .cases a:hover strong { color: var(--fjord); text-decoration: underline; text-underline-offset: .2em; }
  .stat { font-family: var(--font-ui); font-size: .95rem; color: var(--ink-soft); }
  .stat b { color: var(--ink); background: var(--highlight); color: var(--highlight-ink); padding: 0 .3rem; border-radius: 2px; }
  .more { margin: 1.5rem 0 0; font-family: var(--font-ui); font-weight: 600; }

  .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 3rem; align-items: start; }
  .two .section-head { margin-bottom: 0; }
  .bio-wrap { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 2rem; align-items: start; }
  .portrait { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 4px solid var(--surface); box-shadow: 0 0 0 1px var(--rule); }

  @media (max-width: 860px) {
    .split, .cases, .two { grid-template-columns: 1fr; }
    .hero { min-height: 36rem; }
    .bio-wrap { grid-template-columns: 1fr; }
    .portrait { width: 9rem; }
  }
</style>
