---
import Base from '../layouts/Base.astro';
import patches from '../arcade/patches.mjs';
import { LEVELS, RULES } from '../arcade/game.mjs';

const schema = [
  {
    '@type': 'VideoGame',
    name: 'Break my AI',
    url: 'https://junhammer.com/arcade/',
    genre: 'Puzzle',
    gamePlatform: 'Web browser',
    description: 'A prompt injection game. Talk an AI guard into revealing five secret words while its defenses get stronger.',
    author: { '@id': 'https://junhammer.com/#person' },
  },
];
---
<Base
  title="Break my AI"
  seoTitle="Break My AI: A Prompt Injection Arcade Game"
  description="Five doors, five secret words, one AI guard. Talk it into giving each word up while its defenses get harder. Attacks that work become public patches."
  schema={schema}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" />
  <div class="arc-wrap">
    <header class="page-head">
      <h1>Break my AI</h1>
      <p class="lede">An AI guard holds a secret word behind each of five doors. Talk it into giving the word up. Each door adds a defense, and every trick that beats the last door gets patched in public.</p>
    </header>

    <div class="cab" id="cab">
      <div class="cab-marquee" aria-hidden="true">BREAK MY AI</div>
      <div class="cab-hud">
        <span id="hud-door">DOOR -/{RULES.levels}</span>
        <span id="hud-lives" aria-label="Lives">LIVES ---</span>
        <span id="hud-left">MSG --</span>
        <span id="hud-guess">GUESS -</span>
        <button type="button" id="arc-sound" class="cab-btn cab-btn-small" aria-pressed="true">SOUND ON</button>
      </div>

      <div class="cab-screen">
        <div id="arc-attract" class="arc-attract">
          <p class="arc-title">BREAK MY AI</p>
          <p class="arc-sub">{RULES.levels} DOORS · {RULES.lives} LIVES · {RULES.messagesPerLevel} MESSAGES PER DOOR</p>
          <button type="button" id="arc-start" class="cab-btn arc-coin">INSERT COIN</button>
          <p id="arc-notice" class="arc-notice" role="alert"></p>
        </div>
        <div id="arc-log" class="arc-log" role="log" aria-live="polite" hidden></div>
      </div>

      <form id="arc-say" class="cab-row" hidden>
        <label class="arc-sr" for="arc-msg">Message to the guard</label>
        <span class="cab-prompt" aria-hidden="true">&gt;</span>
        <input id="arc-msg" type="text" maxlength={RULES.maxMessage} autocomplete="off" spellcheck="false" placeholder="Talk to the guard" />
        <button class="cab-btn" type="submit">SEND</button>
      </form>
      <form id="arc-guess" class="cab-row cab-row-guess" hidden>
        <label class="arc-sr" for="arc-word">The secret word</label>
        <span class="cab-prompt" aria-hidden="true">#</span>
        <input id="arc-word" type="text" maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Secret word" />
        <button class="cab-btn cab-btn-go" type="submit">OPEN DOOR</button>
        <button class="cab-btn cab-btn-small" type="button" id="arc-forfeit">GIVE UP DOOR (-1 LIFE)</button>
      </form>

      <div id="arc-end" class="arc-end" hidden>
        <p id="arc-end-title" class="arc-title"></p>
        <p id="arc-end-score" class="arc-sub"></p>
        <form id="arc-initials" class="cab-row" hidden>
          <label for="arc-init">ENTER INITIALS</label>
          <input id="arc-init" type="text" maxlength="3" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="AAA" />
          <button class="cab-btn" type="submit">SAVE</button>
        </form>
        <button type="button" id="arc-again" class="cab-btn arc-coin">PLAY AGAIN</button>
      </div>
    </div>

    <div class="arc-tables">
      <section aria-labelledby="arc-scores-h">
        <h2 id="arc-scores-h">High scores</h2>
        <table class="arc-table">
          <thead><tr><th scope="col">Rank</th><th scope="col">Player</th><th scope="col">Doors</th><th scope="col">Messages</th></tr></thead>
          <tbody id="arc-board"><tr><td colspan="4">No scores yet. Be the first.</td></tr></tbody>
        </table>
        <p class="meta">Most doors wins. Fewest messages breaks a tie.</p>
      </section>
      <section aria-labelledby="arc-doors-h">
        <h2 id="arc-doors-h">The doors</h2>
        <table class="arc-table">
          <thead><tr><th scope="col">Door</th><th scope="col">Defense</th><th scope="col">Opened</th></tr></thead>
          <tbody>
            {LEVELS.map((l) => (
              <tr><th scope="row">{l.n}. {l.name}</th><td>{l.defense}</td><td data-door={l.n}>0 of 0</td></tr>
            ))}
          </tbody>
        </table>
        <p class="meta">"Opened" counts players who got the word, out of players who reached the door.</p>
      </section>
    </div>

    <section class="prose arc-about">
      <h2>Patch log</h2>
      <p>Door 5 knows every attack on this list. When a player beats door 4 or 5 with something new, the conversation is saved, the technique becomes a test, and the guard is patched. The finder's initials go here.</p>
      <ol class="arc-patches">
        {patches.map((p) => (<li><strong>{p.technique}.</strong> {p.defense} <span class="meta">{p.foundBy}, {p.date}</span></li>))}
      </ol>

      <h2>What this shows</h2>
      <p>The trick you are playing with is called <a href="https://owasp.org/www-project-top-10-for-large-language-model-applications/">prompt injection</a>: text from a user that talks an AI system out of its instructions. It is the top risk on the OWASP list for applications built on language models. Any chatbot that holds something private, or can take actions, faces it.</p>
      <p>Each door is a real defense that production systems use. Doors 1 and 2 rely on instructions alone, and the guards there are written the way a rushed prompt is, so they fall fast. Door 3 checks the output with code. Door 4 screens the input with a second model. Door 5 stacks all of them and learns from past attacks. No single layer holds. The layers together, plus tests for every attack seen so far, are what make a system hard to break.</p>
      <p>If you are putting an AI assistant in front of customers, this is the work that keeps it on script. See <a href="/services/ai-engineering/">AI engineering</a> or <a href="/tools/">the other tools on this site</a>.</p>

      <h2>Rules and privacy</h2>
      <p>You get {RULES.lives} lives, {RULES.messagesPerLevel} messages and {RULES.guessesPerLevel} guesses per door. Running out of guesses, or giving up a door, costs a life and changes that door's word. Every player gets different words. You can start three games a day, and the arcade closes for the night when it reaches its daily limit.</p>
      <p>Your messages go to Anthropic, the company that makes the model, to generate the guard's replies. Conversations that open door 4 or 5 are kept for 90 days so the attack can be studied. There is no account, and high scores show three letters only. The guard is a sandbox with nothing real to leak.</p>
    </section>
    <noscript><p class="meta">This game needs JavaScript.</p></noscript>
  </div>
</Base>

<script>
  const $ = (id) => document.getElementById(id);
  const log = $('arc-log');
  const attract = $('arc-attract');
  const sayForm = $('arc-say');
  const guessForm = $('arc-guess');
  const endBox = $('arc-end');
  const notice = $('arc-notice');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stored = (k, v) => {
    try {
      if (v === undefined) return localStorage.getItem(k);
      if (v === null) localStorage.removeItem(k);
      else localStorage.setItem(k, v);
    } catch {
      /* private mode: play without saving */
    }
    return null;
  };
  let g = null;
  let busy = false;

  // ---- sound: square waves from the Web Audio API, no files ----
  let audio = null;
  let soundOn = stored('arcade-sound') !== 'off';
  function tone(freq, start, dur, type = 'square', vol = 0.05) {
    if (!soundOn) return;
    try {
      audio = audio || new (window.AudioContext || window.webkitAudioContext)();
      const osc = audio.createOscillator();
      const gain = audio.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      const t = audio.currentTime + start;
      gain.gain.setValueAtTime(vol, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(gain).connect(audio.destination);
      osc.start(t);
      osc.stop(t + dur);
    } catch {
      /* no audio available */
    }
  }
  const sfx = {
    coin: () => [988, 1319].forEach((f, i) => tone(f, i * 0.08, 0.25)),
    send: () => tone(660, 0, 0.06),
    blip: () => tone(420 + Math.random() * 80, 0, 0.03, 'square', 0.025),
    denied: () => [160, 120].forEach((f, i) => tone(f, i * 0.12, 0.18, 'sawtooth', 0.06)),
    open: () => [523, 659, 784, 1047, 1319].forEach((f, i) => tone(f, i * 0.09, 0.2)),
    life: () => [440, 330, 220, 147].forEach((f, i) => tone(f, i * 0.13, 0.22, 'triangle', 0.08)),
    over: () => [392, 370, 349, 262, 196].forEach((f, i) => tone(f, i * 0.2, 0.35, 'triangle', 0.08)),
    win: () => [523, 659, 784, 1047, 784, 1047, 1319, 1568].forEach((f, i) => tone(f, i * 0.11, 0.25)),
  };
  const soundBtn = $('arc-sound');
  const showSound = () => {
    soundBtn.textContent = soundOn ? 'SOUND ON' : 'SOUND OFF';
    soundBtn.setAttribute('aria-pressed', String(soundOn));
  };
  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    stored('arcade-sound', soundOn ? 'on' : 'off');
    showSound();
    sfx.send();
  });
  showSound();

  // ---- screen ----
  function line(kind, text) {
    const p = document.createElement('p');
    p.className = 'arc-line arc-' + kind;
    p.textContent = text;
    log.append(p);
    log.scrollTop = log.scrollHeight;
    return p;
  }
  // Guard replies type out a few characters at a time, with a blip.
  function typeLine(kind, label, text) {
    const p = line(kind, label);
    if (calm) {
      p.textContent = label + text;
      return Promise.resolve();
    }
    return new Promise((done) => {
      let i = 0;
      const step = () => {
        i = Math.min(text.length, i + 2);
        p.textContent = label + text.slice(0, i);
        log.scrollTop = log.scrollHeight;
        if (i % 6 === 0) sfx.blip();
        if (i < text.length) setTimeout(step, 18);
        else done();
      };
      step();
    });
  }

  function hud() {
    $('hud-door').textContent = g ? `DOOR ${g.level}/5` : 'DOOR -/5';
    $('hud-lives').textContent = 'LIVES ' + (g ? '♥'.repeat(g.lives) + '·'.repeat(Math.max(0, 3 - g.lives)) : '---');
    $('hud-left').textContent = 'MSG ' + (g ? String(g.left).padStart(2, '0') : '--');
    $('hud-guess').textContent = 'GUESS ' + (g ? g.guessesLeft : '-');
    const playing = Boolean(g) && !g.over;
    sayForm.hidden = !playing;
    guessForm.hidden = !playing;
    $('arc-msg').disabled = busy || !playing || g.left <= 0;
    $('arc-msg').placeholder = playing && g.left <= 0 ? 'Out of messages. Guess the word or give up the door.' : 'Talk to the guard';
    for (const b of document.querySelectorAll('#cab button, #arc-word')) if (b.id !== 'arc-sound') b.disabled = busy;
  }

  function doorIntro() {
    line('sys', `DOOR ${g.level}: ${g.levelName.toUpperCase()}`);
    line('sys', g.defense + ' Get the word, then type it in the box below.');
  }

  function showEnd() {
    endBox.hidden = false;
    $('arc-end-title').textContent = g.won ? 'YOU BROKE IT' : 'GAME OVER';
    $('arc-end-score').textContent = `${g.cleared} OF 5 DOORS · ${g.messages} MESSAGES`;
    $('arc-initials').hidden = !(g.cleared > 0 && !g.posted);
    hud();
  }

  async function api(body) {
    busy = true;
    hud();
    let data;
    try {
      const res = await fetch('/api/arcade', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      data = await res.json();
      data.ok = res.ok;
    } catch {
      data = { ok: false, error: 'Connection lost. Try again.' };
    }
    if (data.session) g = data;
    busy = false;
    hud();
    return data;
  }

  async function start() {
    sfx.coin();
    notice.textContent = '';
    const data = await api({ action: 'start' });
    if (!data.ok) {
      notice.textContent = data.error;
      sfx.denied();
      return;
    }
    stored('arcade-session', g.session);
    attract.hidden = true;
    endBox.hidden = true;
    log.hidden = false;
    log.replaceChildren();
    doorIntro();
    $('arc-msg').focus();
    refreshBoard();
  }

  sayForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = $('arc-msg');
    const message = input.value.trim();
    if (!message || busy) return;
    input.value = '';
    sfx.send();
    line('you', 'YOU: ' + message);
    const data = await api({ action: 'say', session: g.session, message });
    if (!data.ok && !data.reply) {
      line('bad', data.error || 'Something went wrong.');
      sfx.denied();
    } else if (data.blocked) {
      sfx.denied();
      line('bad', '[BLOCKED] ' + data.reply);
    } else await typeLine('guard', 'GUARD: ', data.reply);
    hud();
    if (!input.disabled) input.focus();
  });

  async function settle(data) {
    if (data.result === 'open') {
      line('good', `DOOR ${data.door} OPEN.`);
      if (g.won) sfx.win();
      else {
        sfx.open();
        doorIntro();
      }
    } else if (data.result === 'wrong') {
      sfx.denied();
      line('bad', `WRONG WORD. ${g.guessesLeft} ${g.guessesLeft === 1 ? 'guess' : 'guesses'} left.`);
    } else if (data.result === 'life') {
      line('bad', `LIFE LOST. The word was ${data.reveal}.`);
      if (g.over) sfx.over();
      else {
        sfx.life();
        line('sys', 'The door has a new word now.');
      }
    } else if (data.error) {
      line('bad', data.error);
      if (data.reason === 'no_game') stored('arcade-session', null);
    }
    if (g?.over) showEnd();
    refreshBoard();
  }

  guessForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = $('arc-word');
    const guess = input.value.trim();
    if (!guess || busy) return;
    input.value = '';
    await settle(await api({ action: 'guess', session: g.session, guess }));
  });
  $('arc-forfeit').addEventListener('click', async () => {
    if (!busy) await settle(await api({ action: 'forfeit', session: g.session }));
  });

  $('arc-initials').addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = await api({ action: 'initials', session: g.session, initials: $('arc-init').value });
    if (data.board) {
      sfx.open();
      $('arc-initials').hidden = true;
      renderBoard(data.board);
    } else {
      sfx.denied();
      $('arc-end-score').textContent = data.error || 'Could not save.';
    }
  });
  $('arc-start').addEventListener('click', start);
  $('arc-again').addEventListener('click', start);

  // ---- tables ----
  function renderBoard(board) {
    if (!board?.length) return;
    $('arc-board').replaceChildren(
      ...board.map((b, i) => {
        const tr = document.createElement('tr');
        for (const v of [String(i + 1).padStart(2, '0'), b.initials, b.doors, b.messages]) {
          const td = document.createElement('td');
          td.textContent = v;
          tr.append(td);
        }
        return tr;
      }),
    );
  }
  async function refreshBoard() {
    try {
      const pub = await (await fetch('/api/arcade')).json();
      renderBoard(pub.board);
      for (const cell of document.querySelectorAll('[data-door]')) {
        const n = Number(cell.dataset.door) - 1;
        cell.textContent = `${pub.clears[n]} of ${pub.tries[n]}`;
      }
      if (pub.open === false) {
        notice.textContent = 'The arcade is closed right now.';
        $('arc-start').disabled = true;
      }
    } catch {
      /* tables keep their defaults */
    }
  }

  // Pick up a game in progress after a reload.
  (async () => {
    refreshBoard();
    const id = stored('arcade-session');
    if (!id) return hud();
    const data = await api({ action: 'state', session: id });
    if (!data.ok || data.over) {
      g = null;
      stored('arcade-session', null);
      return hud();
    }
    attract.hidden = true;
    log.hidden = false;
    doorIntro();
    for (const m of g.history) line(m.role === 'user' ? 'you' : 'guard', (m.role === 'user' ? 'YOU: ' : 'GUARD: ') + m.content);
    hud();
  })();
</script>

<style is:global>
  .arc-wrap { width: min(100% - 2rem, 900px); margin-inline: auto; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .arc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .cab { --px: 'Press Start 2P', ui-monospace, Menlo, monospace; --crt: 'VT323', ui-monospace, Menlo, Consolas, monospace; --g: #6dff9c; --amber: #ffd166; --cyan: #6be4ff; --pink: #ff5fd2; --red: #ff6b6b;
    margin-top: 1.5rem; padding: clamp(.75rem, 2.5vw, 1.25rem); border-radius: 18px; background: linear-gradient(180deg, #23233a, #11111d); border: 3px solid #05050a; box-shadow: 0 0 0 2px #3a3a5c inset, 0 18px 40px rgba(0, 0, 0, .35); color: #e8e8ff; }
  .cab-marquee { font-family: var(--px); font-size: clamp(.9rem, 3.4vw, 1.5rem); text-align: center; letter-spacing: .12em; padding: .9rem .5rem; border-radius: 10px; color: #fff; background: linear-gradient(90deg, #3d1466, #7a1260, #3d1466); text-shadow: 0 0 6px var(--pink), 0 0 18px var(--pink); border: 2px solid #05050a; }
  .cab-hud { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.1rem; margin: .8rem .2rem; font-family: var(--px); font-size: .62rem; color: var(--amber); }
  .cab-hud .cab-btn { margin-left: auto; }
  #hud-lives { color: var(--red); }

  .cab-screen { position: relative; height: clamp(300px, 52vh, 460px); border-radius: 14px; border: 3px solid #05050a; background: radial-gradient(ellipse at center, #0c1512 0%, #050807 75%); overflow: hidden; box-shadow: inset 0 0 60px rgba(0, 0, 0, .8); }
  .cab-screen::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0) 0 2px, rgba(0, 0, 0, .28) 2px 4px); }
  .arc-log { height: 100%; overflow-y: auto; padding: 1rem 1.1rem 1.4rem; font-family: var(--crt); font-size: 1.35rem; line-height: 1.25; scrollbar-color: #2c4a3a transparent; }
  .arc-line { margin: 0 0 .55rem; white-space: pre-wrap; overflow-wrap: anywhere; text-shadow: 0 0 6px currentColor; }
  .arc-guard { color: var(--g); }
  .arc-you { color: var(--cyan); }
  .arc-sys { color: var(--amber); }
  .arc-bad { color: var(--red); }
  .arc-good { color: #fff; font-family: var(--px); font-size: .8rem; line-height: 1.8; }

  .arc-attract, .arc-end { display: grid; place-content: center; justify-items: center; gap: 1.1rem; text-align: center; padding: 1rem; }
  .arc-attract { height: 100%; }
  .arc-attract[hidden], .arc-end[hidden], .arc-log[hidden], .cab-row[hidden] { display: none; }
  .arc-end { margin-top: .8rem; padding: 1.4rem 1rem; border-radius: 12px; border: 2px solid #05050a; background: #0a0a14; }
  .arc-title { margin: 0; font-family: var(--px); font-size: clamp(1rem, 4.5vw, 1.9rem); line-height: 1.5; color: var(--g); text-shadow: 0 0 8px var(--g), 0 0 22px var(--g); }
  .arc-sub { margin: 0; font-family: var(--px); font-size: .6rem; line-height: 1.9; color: var(--amber); }
  .arc-notice { margin: 0; min-height: 1.2em; font-family: var(--crt); font-size: 1.2rem; color: var(--red); }
  .arc-coin { animation: arc-blink 1.1s steps(2, start) infinite; }
  @keyframes arc-blink { to { opacity: .35; } }

  .cab-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: .7rem; font-family: var(--px); font-size: .62rem; color: var(--amber); }
  .cab-prompt { font-family: var(--px); font-size: .8rem; color: var(--g); }
  .cab-row input { flex: 1; min-width: 9rem; padding: .65rem .75rem; border-radius: 8px; border: 2px solid #05050a; background: #05080a; color: var(--g); font-family: var(--crt); font-size: 1.3rem; caret-color: var(--g); }
  .cab-row input::placeholder { color: #3f6a52; }
  .cab-row input:focus-visible, .cab-btn:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .cab-row-guess input { color: var(--amber); text-transform: uppercase; }
  #arc-init { flex: 0 0 6.5rem; text-align: center; letter-spacing: .3em; text-transform: uppercase; }
  .cab-btn { font-family: var(--px); font-size: .68rem; line-height: 1; padding: .8rem .9rem; border-radius: 8px; border: 2px solid #05050a; background: #ffd166; color: #1a1205; cursor: pointer; box-shadow: 0 4px 0 #9a6b00; }
  .cab-btn:active { transform: translateY(3px); box-shadow: 0 1px 0 #9a6b00; }
  .cab-btn:disabled { opacity: .5; cursor: default; }
  .cab-btn-go { background: var(--g); box-shadow: 0 4px 0 #1f7a43; }
  .cab-btn-small { font-size: .52rem; padding: .55rem .6rem; background: #2c2c48; color: #d6d6ff; box-shadow: 0 3px 0 #05050a; }

  .arc-tables { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-top: 2.5rem; }
  .arc-tables h2, .arc-about h2 { font-size: var(--step-2); }
  .arc-table { width: 100%; border-collapse: collapse; margin-top: .6rem; font-family: var(--font-ui); font-size: var(--step--1); }
  .arc-table th, .arc-table td { text-align: left; padding: .5rem .55rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .arc-table thead th { color: var(--ink-soft); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
  .arc-table tbody th { font-weight: 600; white-space: nowrap; }
  #arc-board td { font-family: ui-monospace, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
  .arc-about { margin-top: 2.5rem; }
  .arc-patches { display: grid; gap: .6rem; }
  .arc-patches .meta { display: block; }
  @media (prefers-reduced-motion: reduce) { .arc-coin { animation: none; } }
  @media (max-width: 520px) { .cab-hud .cab-btn { margin-left: 0; } .arc-log { font-size: 1.2rem; } }
</style>
